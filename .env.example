# ==========================================
# Korykos Boutique Hotel & Beach — Otel_DM_Demo Ortam Değişkenleri
# ==========================================
# Yerel çalışmada repo kökündeki `_knowledge/credentials/master.env` otomatik okunur.
# Farklı bir otel için özelleştirme yapmak isterseniz bu dosyayı `.env` adıyla kopyalayın.

# --- Otel Kimliği ---
HOTEL_NAME=Korykos Boutique Hotel & Beach
HOTEL_PHONE=+90 324 523 00 42
HOTEL_WHATSAPP=+90 532 000 33 42
HOTEL_EMAIL=info@korykoshotel.com
HOTEL_WEBSITE=https://www.korykoshotel.com

# --- OpenAI (Ana Sohbet + Ses Çevirisi + Görsel Okuma) ---
OPENAI_API_KEY=<MASTER_ENV_UZERINDEN_OTOMATIK_OKUNUR>
HOTEL_AGENT_MODEL=gpt-4.1-mini
HOTEL_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
HOTEL_VISION_MODEL=gpt-4o-mini

# --- Telegram (Personel Devir Bildirimi) ---
TELEGRAM_BOT_TOKEN=<MASTER_ENV_UZERINDEN_OTOMATIK_OKUNUR>
ADMIN_CHAT_ID=<MASTER_ENV_UZERINDEN_OTOMATIK_OKUNUR>

# --- Aşama 2 & 3 (Opsiyonel: Supabase & ManyChat) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MANYCHAT_API_TOKEN=
HOTEL_WEBHOOK_SECRET=
HOTEL_DRY_RUN=0

